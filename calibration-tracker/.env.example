PORT=3001
ADMIN_USER=admin
ADMIN_PASS=admin123
SESSION_SECRET=change-this-to-something-random

# --- Notification settings ---
REMIND_WITHIN_DAYS=14

# Email (SMTP) - example values for Gmail (use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=youraddress@gmail.com

# SMS (Twilio) - leave blank to disable SMS sending
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
