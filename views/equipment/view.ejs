<%- include('../partials/header', { title: 'Equipment Details', username }) %>

<div style="margin-bottom: 8px;">
  <a href="/" class="hint" style="font-size: 13px;">&larr; Back to Dashboard</a>
</div>

<h1><%= equipment.serial_number || 'Equipment' %></h1>
<p class="subtitle"><%= equipment.brand || '—' %> <%= equipment.equipment_type || '' %> &middot; <%= equipment.customer_name %></p>

<div class="actions-row">
  <div></div>
  <div>
    <a href="/equipment/<%= equipment.id %>/edit" class="btn secondary">Edit Equipment</a>
    <form method="POST" action="/equipment/<%= equipment.id %>/mark-done" style="display:inline">
      <button type="submit" class="btn secondary">Mark Done Today</button>
    </form>
    <a href="/calibrations/new" class="btn gold">+ Add Calibration</a>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-title">Company/Client Deatils</div>
  <div class="detail-grid">
    <div>
      <div class="detail-label">Customer Name/Client Name</div>
      <div class="detail-value"><%= equipment.customer_name %></div>
    </div>
    <div>
      <div class="detail-label">Company Address</div>
      <div class="detail-value"><%= equipment.customer_company || '—' %></div>
    </div>
    <div>
      <div class="detail-label">Phone</div>
      <div class="detail-value"><%= equipment.customer_phone || '—' %></div>
    </div>
    <div>
      <div class="detail-label">Email</div>
      <div class="detail-value"><%= equipment.customer_email || '—' %></div>
    </div>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-title">Equipment Details</div>
  <div class="detail-grid">
    <div>
      <div class="detail-label">Equipment Type</div>
      <div class="detail-value"><%= equipment.equipment_type || '—' %></div>
    </div>
    <div>
      <div class="detail-label">Brand</div>
      <div class="detail-value"><%= equipment.brand || '—' %></div>
    </div>
    <div>
      <div class="detail-label">Model</div>
      <div class="detail-value"><%= equipment.model || '—' %></div>
    </div>
    <div>
      <div class="detail-label">Serial Number</div>
      <div class="detail-value"><%= equipment.serial_number || '—' %></div>
    </div>
    <div>
      <div class="detail-label">Status</div>
      <div class="detail-value">
        <span class="badge badge-grey"><%= equipment.status || '—' %></span>
      </div>
    </div>
    <div>
      <div class="detail-label">Last Calibration</div>
      <div class="detail-value"><%= equipment.last_calibration_date || '—' %></div>
    </div>
    <div>
      <div class="detail-label">Next Calibration</div>
      <div class="detail-value"><%= equipment.next_calibration_date || '—' %></div>
    </div>
    <div>
      <div class="detail-label">Sold By Us</div>
      <div class="detail-value"><%= equipment.sold_by_us || '—' %></div>
    </div>
    <% if (equipment.sold_by_us === 'Yes') { %>
      <div>
        <div class="detail-label">Purchase Date</div>
        <div class="detail-value"><%= equipment.purchase_date || '—' %></div>
      </div>
      <div>
        <div class="detail-label">Warranty Period</div>
        <div class="detail-value"><%= equipment.warranty_period_months ? equipment.warranty_period_months + ' months' : '—' %></div>
      </div>
    <% } %>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-title">Calibration History</div>

  <% if (calibrations.length === 0) { %>
    <div class="empty-state">No calibration records logged for this equipment yet.</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Description</th>
          <th>Done?</th>
          <th>Status</th>
          <th>Done Date</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% calibrations.forEach(c => { %>
          <tr>
            <td><%= c.description || '—' %></td>
            <td><%= c.done %></td>
            <td><%= c.status || '—' %></td>
            <td><%= c.done_date || '—' %></td>
            <td class="text-nowrap">
              <a href="/calibrations/<%= c.id %>/edit" class="btn small secondary">Edit</a>
              <!-- Opens the QR panel for this instrument. Every row shows the
                   same code on purpose — the QR identifies the equipment, not
                   an individual service record. -->
              <% if (qrImage) { %>
                <button type="button" class="btn small qr" onclick="openQrModal()" title="QR code for <%= equipment.serial_number %>">
                  <i class="bi bi-qr-code"></i> QR
                </button>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<!-- QR panel, hidden until a QR button in the history table is clicked. -->
<% if (qrImage) { %>
  <div class="qr-modal-overlay" id="qrModal" onclick="if (event.target === this) closeQrModal()">
    <div class="qr-modal" role="dialog" aria-modal="true" aria-label="QR code">
      <div class="qr-modal-head">
        <div class="detail-card-title" style="margin:0;">QR Code</div>
        <button type="button" class="qr-modal-close" onclick="closeQrModal()" aria-label="Close">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <div class="qr-block">
        <div class="qr-preview">
          <img src="<%= qrImage %>" alt="QR code for <%= equipment.serial_number %>">
          <div class="qr-caption"><%= equipment.serial_number || 'Equipment' %></div>
        </div>
        <div class="qr-info">
          <p class="qr-text">
            Print this code and stick it on the instrument. Scanning it with any phone
            camera opens a read-only page with the full equipment details and every
            calibration record logged against it — no login needed.
          </p>
          <div class="qr-url-row">
            <input type="text" id="qrScanUrl" class="qr-url" value="<%= scanUrl %>" readonly>
            <button type="button" class="btn small secondary" onclick="copyScanUrl()">
              <i class="bi bi-clipboard"></i> Copy
            </button>
          </div>
          <div class="qr-actions">
            <a href="/equipment/<%= equipment.id %>/qr.png" class="btn small gold" download>
              <i class="bi bi-download"></i> Download QR
            </a>
            <button type="button" class="btn small secondary" onclick="printQr()">
              <i class="bi bi-printer"></i> Print Sticker
            </button>
            <a href="<%= scanUrl %>" target="_blank" rel="noopener" class="btn small secondary">
              <i class="bi bi-box-arrow-up-right"></i> Preview Scan Page
            </a>
          </div>
          <p class="hint qr-hint">
            Phones must be on the same network as this server for the link to open.
            If the address above says <code>localhost</code>, set <code>PUBLIC_BASE_URL</code> in your <code>.env</code>.
          </p>
        </div>
      </div>
    </div>
  </div>
<% } %>

<script>
  function openQrModal() {
    document.getElementById('qrModal').classList.add('is-open');
  }

  function closeQrModal() {
    document.getElementById('qrModal').classList.remove('is-open');
  }

  // Esc closes the panel, matching what people expect from a dialog.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeQrModal();
  });

  function copyScanUrl() {
    const field = document.getElementById('qrScanUrl');
    field.select();
    field.setSelectionRange(0, 99999); // iOS needs the explicit range
    if (navigator.clipboard) {
      navigator.clipboard.writeText(field.value);
    } else {
      document.execCommand('copy');
    }
  }

  // Opens just the QR + serial number in a small window and sends it to the
  // printer, so you get a clean sticker instead of the whole page.
  function printQr() {
    const serial = <%- JSON.stringify(equipment.serial_number || 'Equipment') %>;
    const brand = <%- JSON.stringify([equipment.brand, equipment.model].filter(Boolean).join(' ')) %>;
    const img = <%- JSON.stringify(qrImage || '') %>;

    const win = window.open('', '_blank', 'width=420,height=560');
    win.document.write(`
      <html>
        <head>
          <title>QR — ${serial}</title>
          <style>
            body { font-family: Arial, sans-serif; text-align: center; padding: 24px; margin: 0; }
            img { width: 260px; height: 260px; }
            .serial { font-size: 20px; font-weight: 700; margin-top: 10px; }
            .brand { font-size: 13px; color: #555; }
            .co { font-size: 11px; color: #777; margin-top: 12px; letter-spacing: 1px; }
          </style>
        </head>
        <body>
          <img src="${img}" alt="QR">
          <div class="serial">${serial}</div>
          <div class="brand">${brand}</div>
          <div class="co">SULECO (PVT) LTD &middot; SCAN FOR SERVICE HISTORY</div>
        </body>
      </html>
    `);
    win.document.close();
    win.focus();
    setTimeout(() => win.print(), 300);
  }
</script>

<%- include('../partials/footer') %>