<%- include('partials/header', { title: 'Notification Log — Calibration Tracker', username }) %>

<h1>Notification Log</h1>
<p class="subtitle">Most recent 200 reminder attempts (email and SMS).</p>

<div class="actions-row">
  <div></div>
  <div>
    <a href="/" class="btn secondary">Back to Dashboard</a>
  </div>
</div>

<div class="card" style="margin-bottom: 20px;">
  <div class="hint" style="margin-bottom: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: 12px;">
    Send Test Notification
  </div>
  <p class="hint" style="margin-bottom: 14px;">
    Enter an email and/or phone number to send a one-off test message right now, and confirm below whether it actually went out.
  </p>
  <form method="POST" action="/notifications/test" style="display:grid; grid-template-columns: 1fr 1fr auto; gap: 12px; align-items: end;">
    <div class="form-group" style="margin: 0;">
      <label>Test Email</label>
      <input type="email" name="test_email" placeholder="you@example.com">
    </div>
    <div class="form-group" style="margin: 0;">
      <label>Test Phone</label>
      <input type="text" name="test_phone" placeholder="e.g. 0771234567">
    </div>
    <button type="submit" class="btn gold" style="height: 38px;">Send Test</button>
  </form>

  <% if (typeof testResults !== 'undefined' && testResults && testResults.length > 0) { %>
    <div style="margin-top: 18px;">
      <div class="hint" style="margin-bottom: 8px;">Result</div>
      <table>
        <thead>
          <tr>
            <th>Channel</th>
            <th>Target</th>
            <th>Status</th>
            <th>Detail</th>
          </tr>
        </thead>
        <tbody>
          <% testResults.forEach(r => { %>
            <tr>
              <td><%= r.channel %></td>
              <td><%= r.target %></td>
              <td>
                <span class="badge <%= r.status.startsWith('sent') ? 'badge-green' : (r.status === 'failed' ? 'badge-red' : 'badge-grey') %>">
                  <%= r.status %>
                </span>
              </td>
              <td>
                <% if (r.detail && r.detail.startsWith('http')) { %>
                  <a href="<%= r.detail %>" target="_blank" rel="noopener">View test email preview</a>
                <% } else { %>
                  <%= r.detail || '—' %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<h2 style="margin-top:28px;">Automatic Run History</h2>
<p class="subtitle">
  Proof that the scheduled job fired. It is set to run daily at
  <strong><%= dailyRunTime %></strong> (<%= timezone %>).
  A <span class="badge badge-amber">catch-up</span> row means the app was not running at that
  exact time (PC off or asleep), so it ran as soon as it started up instead.
</p>

<% if (!runs || runs.length === 0) { %>
  <div class="empty-state">No sweeps have run yet.</div>
<% } else { %>
<table>
  <thead>
    <tr>
      <th>Run Date</th>
      <th>Finished At</th>
      <th>Trigger</th>
      <th>Checked</th>
      <th>Reminders Sent</th>
      <th>Email</th>
      <th>SMS</th>
      <th>Recipients</th>
    </tr>
  </thead>
  <tbody>
    <% runs.forEach(run => { %>
      <tr>
        <td><%= run.run_date %></td>
        <td><%= run.finished_at || '(still running)' %></td>
        <td>
          <% if (run.trigger_type === 'scheduled') { %>
            <span class="badge badge-green">automatic</span>
          <% } else if (run.trigger_type === 'catchup') { %>
            <span class="badge badge-amber">catch-up</span>
          <% } else { %>
            <span class="badge badge-grey">manual</span>
          <% } %>
        </td>
        <td><%= run.checked %></td>
        <td><strong><%= run.notified %></strong></td>
        <td>
          <%= run.email_sent %> sent<% if (run.email_failed > 0) { %>,
          <span style="color:var(--red);"><%= run.email_failed %> failed</span><% } %>
        </td>
        <td>
          <%= run.sms_sent %> sent<% if (run.sms_failed > 0) { %>,
          <span style="color:var(--red);"><%= run.sms_failed %> failed</span><% } %>
        </td>
        <td>
          <% if (run.error) { %>
            <span class="badge badge-red">error</span> <span class="hint"><%= run.error %></span>
          <% } else if (run.recipientList.length === 0) { %>
            <span class="hint">nothing due</span>
          <% } else { %>
            <span class="hint"><%= run.recipientList.map(r => r.renamed ? r.customer + ' (sent as ' + r.sentAs + ')' : r.customer).join(', ') %></span>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<h2 style="margin-top:28px;">Individual Messages</h2>

<% if (logs.length === 0) { %>
  <div class="empty-state">No notifications have been sent yet.</div>
<% } else { %>
<table>
  <thead>
    <tr>
      <th>Sent At</th>
      <th>Customer</th>
      <th>Channel</th>
      <th>Target</th>
      <th>Status</th>
      <th>Detail</th>
    </tr>
  </thead>
  <tbody>
    <% logs.forEach(l => { %>
      <tr>
        <td><%= l.sent_at %></td>
        <td>
          <%= l.current_customer_name || l.customer_name %>
          <% if (l.current_customer_name && l.customer_name && l.current_customer_name !== l.customer_name) { %>
            <br><span class="hint">sent as <%= l.customer_name %></span>
          <% } %>
        </td>        <td><%= l.channel %></td>
        <td><%= l.target || '—' %></td>
        <td>
          <span class="badge <%= l.status === 'sent' ? 'badge-green' : (l.status === 'failed' ? 'badge-red' : 'badge-grey') %>">
            <%= l.status %>
          </span>
        </td>
        <td><%= l.detail || '—' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<%- include('partials/footer') %>