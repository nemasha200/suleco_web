<%- include('../partials/header', { title: (customer ? 'Edit' : 'Add') + ' Customer', username, bodyClass: 'customers-page' }) %>
<h1><%= customer ? 'Edit Customer' : 'Add Customer' %></h1>
<p class="subtitle">Customer / company details.</p>

<div class="card">
  <!-- Negative margins pull the strip out to the card's edges, cancelling the
       card's own 24px padding so the blue runs corner to corner. -->
  <div class="d-flex align-items-center gap-2 mb-4"
       style="background: var(--navy); color: #fff; margin: -24px -24px 0; padding: 16px 24px; border-radius: 10px 10px 0 0;">
    <i class="bi bi-person-fill fs-4" style="color: var(--gold);"></i>
    <span style="font-weight:700;"><%= customer ? 'Edit Customer' : 'New Customer' %></span>
  </div>

  <form method="POST" action="<%= customer ? '/customers/' + customer.id + '/edit' : '/customers/new' %>">
    <div class="form-group">
      <label>Company Name</label>
      <input type="text" name="name" required value="<%= customer ? customer.name : '' %>">
    </div>
    <div class="form-group">
      <label>Company Address</label>
      <input type="text" name="company" value="<%= customer ? (customer.company || '') : '' %>">
    </div>
    <div class="form-group">
      <label>Phone</label>
      <input type="text" name="phone" value="<%= customer ? (customer.phone || '') : '' %>">
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="<%= customer ? (customer.email || '') : '' %>">
    </div>
    <button type="submit" class="btn">Save Customer</button>
    <a href="/customers" class="btn secondary">Cancel</a>
  </form>
</div>

<%- include('../partials/footer') %>