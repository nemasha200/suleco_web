<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Technical Tracker' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/console.css">
</head>
<body class="console-body">

<!-- ===== Sidebar shell =====
     Used by the dashboard. The rest of the app still runs on the top navbar
     in partials/header.ejs — the two can coexist because each page includes
     whichever shell it wants. To move another page onto this layout, swap its
     header include for this one and its footer include for console-footer. -->
<div class="console">

  <aside class="console-side" id="consoleSide">
    <div class="console-brand">
      <img src="/images/suleco-logo-nav.png" alt="Suleco">
      <div>
        <div class="console-brand__title">Technical Tracker</div>
        <div class="console-brand__sub">Suleco Technical Division</div>
      </div>
    </div>

    <nav class="console-nav">
      <a href="/" class="<%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'active' : '' %>">
        <i class="bi bi-house-door-fill"></i> Dashboard
      </a>
      <a href="/calibrations" class="<%= typeof activeNav !== 'undefined' && activeNav === 'services' ? 'active' : '' %>">
        <i class="bi bi-wrench-adjustable"></i> Services
      </a>
      <a href="/equipment/new" class="<%= typeof activeNav !== 'undefined' && activeNav === 'equipment' ? 'active' : '' %>">
        <i class="bi bi-box-seam-fill"></i> Equipment
      </a>
      <a href="/customers" class="<%= typeof activeNav !== 'undefined' && activeNav === 'customers' ? 'active' : '' %>">
        <i class="bi bi-people-fill"></i> Customers
      </a>
      <a href="/export.csv">
        <i class="bi bi-file-earmark-bar-graph-fill"></i> Reports
      </a>
      <a href="/notifications" class="<%= typeof activeNav !== 'undefined' && activeNav === 'notifications' ? 'active' : '' %>">
        <i class="bi bi-bell-fill"></i> Notifications
        <% if (typeof alertCount !== 'undefined' && alertCount > 0) { %>
          <span class="console-nav__count"><%= alertCount %></span>
        <% } %>
      </a>
    </nav>

    <div class="console-side__foot">
      <form method="POST" action="/logout">
        <button type="submit"><i class="bi bi-box-arrow-right"></i> Sign out</button>
      </form>
    </div>
  </aside>

  <div class="console-main">
    <header class="console-top">
      <button type="button" class="console-burger" id="consoleBurger" aria-label="Toggle menu">
        <i class="bi bi-list"></i>
      </button>

      <form method="GET" action="/search" class="console-search">
        <i class="bi bi-search"></i>
        <input type="text" name="q" placeholder="Search by serial number…" autocomplete="off"
               value="<%= typeof q !== 'undefined' ? q : '' %>">
      </form>

      <div class="console-top__right">
        <a href="/notifications" class="console-bell" title="Notification log">
          <i class="bi bi-bell"></i>
          <% if (typeof alertCount !== 'undefined' && alertCount > 0) { %><span class="console-bell__dot"></span><% } %>
        </a>
        <div class="console-user">
          <div class="console-user__avatar"><%= typeof username !== 'undefined' && username ? username.slice(0, 2).toUpperCase() : 'AD' %></div>
          <div class="console-user__text">
            <div class="console-user__name"><%= typeof username !== 'undefined' ? username : 'admin' %></div>
            <div class="console-user__role">Admin</div>
          </div>
        </div>
      </div>
    </header>

    <main class="console-content">
