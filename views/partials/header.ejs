<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Technical Tracker' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<div class="topbar-v2">
  <div class="brand-block">
    <div class="brand-text">
      <div class="brand-badge"><img src="/images/suleco-logo-nav.png" alt="Suleco" class="brand-logo-img"></div>
      <div class="brand-title">Calibration <span>Tracker</span></div>
    </div>
  </div>

  <nav>
    <a href="/" class="<%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/customers" class="<%= typeof activeNav !== 'undefined' && activeNav === 'customers' ? 'active' : '' %>">Customers</a>
    <a href="/equipment/new" class="<%= typeof activeNav !== 'undefined' && activeNav === 'equipment' ? 'active' : '' %>">Add Equipment</a>
    <a href="/calibrations" class="<%= typeof activeNav !== 'undefined' && activeNav === 'services' ? 'active' : '' %>">Services</a>
  </nav>

  <div class="actions">
    <a href="/notifications" class="bell-btn" title="Notification Log">
      <i class="bi bi-bell"></i>
      <span class="bell-dot"></span>
    </a>
    <a href="/export.csv" class="btn gold" style="padding: 8px 14px;"><i class="bi bi-download"></i> Export CSV</a>
    <div class="avatar-chip">
      <div class="avatar-circle"><%= typeof username !== 'undefined' && username ? username.charAt(0).toUpperCase() : 'A' %></div>
      <span><%= typeof username !== 'undefined' ? username : 'admin' %></span>
      <form method="POST" action="/logout" class="logout-form" style="display:inline">
        <button type="submit" title="Logout"><i class="bi bi-box-arrow-right"></i></button>
      </form>
    </div>
  </div>
</div>
<div class="container">