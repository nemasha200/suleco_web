<%- include('partials/header', { title: 'Search — Calibration Tracker', username, q }) %>

<h1>Search</h1>
<p class="subtitle">
  <% if (q) { %>
    Results for "<strong><%= q %></strong>"
  <% } else { %>
    Search by serial number (also matches customer name, brand, or equipment type).
  <% } %>
</p>

<% if (!q) { %>
  <div class="empty-state">Type a serial number in the search box above and hit Search.</div>
<% } else if (results.length === 0) { %>
  <!-- A miss is a dead end unless we offer the next step. Both routes carry
       the typed text across so nothing has to be retyped. -->
  <div class="card" style="max-width: 620px; margin: 0 auto; text-align: center; padding: 32px 28px;">
    <i class="bi bi-search" style="font-size: 32px; color: var(--gold);"></i>
    <h2 style="font-size: 19px; margin: 14px 0 6px;">Nothing on file for &ldquo;<%= q %>&rdquo;</h2>
    <p class="hint" style="margin-bottom: 22px;">
      No equipment has that serial number. Register the instrument, add the customer first if
      they are new, or go back and try another serial.
    </p>

    <div style="display:flex; flex-wrap:wrap; gap:10px; justify-content:center;">
      <a href="/equipment/new?serial=<%= encodeURIComponent(q) %>" class="btn gold">
        <i class="bi bi-box-seam"></i> Add as New Equipment
      </a>
      <!-- No name is passed: the box searches serials, so the typed text is a
           serial, not a company name. This is a shortcut to the blank form. -->
      <a href="/customers/new" class="btn secondary">
        <i class="bi bi-person-plus"></i> Add New Customer
      </a>
      <a href="/" class="btn secondary">
        <i class="bi bi-speedometer2"></i> Back to Dashboard
      </a>
    </div>

    <div class="hint" style="margin-top: 18px;">
      Shortcuts: press <kbd>E</kbd> to add equipment, <kbd>C</kbd> to add a customer,
      <kbd>D</kbd> for the dashboard, <kbd>Esc</kbd> to search again.
    </div>
  </div>

  <script>
    // Single-key shortcuts, ignored while typing so they never hijack a field.
    const SEARCH_TERM = <%- JSON.stringify(q) %>;
    document.addEventListener("keydown", (e) => {
      if (e.ctrlKey || e.altKey || e.metaKey) return;
      const tag = (e.target.tagName || "").toLowerCase();
      if (tag === "input" || tag === "textarea" || tag === "select") {
        if (e.key === "Escape") e.target.blur();
        return;
      }

      const key = e.key.toLowerCase();
      if (key === "d") window.location.href = "/";
      else if (key === "e") window.location.href = "/equipment/new?serial=" + encodeURIComponent(SEARCH_TERM);
      else if (key === "c") window.location.href = "/customers/new";
      else if (e.key === "Escape") {
        const box = document.querySelector('input[name="q"]');
        if (box) { box.focus(); box.select(); }
      }
    });
  </script>
<% } else { %>

  <% results.forEach(e => { %>
    <div class="card" style="margin-bottom: 20px;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap: wrap; gap: 12px;">
        <div>
          <div style="font-size: 17px; font-weight: 700; color: var(--navy);">
            <%= e.serial_number || '—' %>
            <span class="badge <%= e.badge.className %>" style="margin-left: 8px;"><%= e.badge.label %></span>
          </div>
          <div class="hint" style="margin-top: 4px;">
            <%= e.brand || '—' %> <%= e.equipment_type || '' %> &middot;
            <%= e.customer_name %><% if (e.customer_phone) { %> &middot; <%= e.customer_phone %><% } %>
          </div>
        </div>
        <div>
          <a href="/equipment/<%= e.id %>/edit" class="btn small secondary">Edit Equipment</a>
          <form method="POST" action="/equipment/<%= e.id %>/mark-done" style="display:inline">
            <button type="submit" class="btn small secondary">Mark Done Today</button>
          </form>
          <% if (e.openJobId) { %>
            <a href="/calibrations/<%= e.openJobId %>/workflow" class="btn small gold">
              <i class="bi bi-arrow-right-circle"></i> Continue Job
            </a>
          <% } else { %>
            <a href="/calibrations/new?equipment_id=<%= e.id %>" class="btn small gold">
              <i class="bi bi-box-arrow-in-down"></i> Check In
            </a>
          <% } %>
        </div>
      </div>

      <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 16px;">
        <div>
          <div class="hint" style="margin-bottom: 3px;">Last Calibration</div>
          <div style="font-weight: 600; font-size: 14px;"><%= e.last_calibration_date || '—' %></div>
        </div>
        <div>
          <div class="hint" style="margin-bottom: 3px;">Next Calibration</div>
          <div style="font-weight: 600; font-size: 14px;"><%= e.next_calibration_date || '—' %></div>
        </div>
        <div>
          <div class="hint" style="margin-bottom: 3px;">Status</div>
          <div style="font-weight: 600; font-size: 14px;"><%= e.status || '—' %></div>
        </div>
      </div>

      <% if (e.calibrations.length > 0) { %>
        <div style="margin-top: 18px;">
          <div class="hint" style="margin-bottom: 8px;">Calibration History</div>
          <table>
            <thead>
              <tr>
                <th>Description</th>
                <th>Done?</th>
                <th>Status</th>
                <th>Done Date</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% e.calibrations.forEach(c => { %>
                <tr>
                  <td><%= c.description || '—' %></td>
                  <td><%= c.done %></td>
                  <td><%= c.status || '—' %></td>
                  <td><%= c.done_date || '—' %></td>
                  <td><a href="/calibrations/<%= c.id %>/edit" class="btn small secondary">Edit</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="hint" style="margin-top: 14px;">No calibration records logged for this equipment yet.</div>
      <% } %>
    </div>
  <% }) %>

<% } %>

<%- include('partials/footer') %>